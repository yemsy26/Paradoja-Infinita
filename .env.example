# Copia este archivo como ".env" (sin ".example") y rellena tus datos.
# NUNCA subas el .env a Git ni lo compartas: contiene el acceso a tu pagina (ya esta en .gitignore).

# --- Obligatorios ---
PAGE_ID=
PAGE_ACCESS_TOKEN=

# --- Franjas horarias (hora del PC, formato HH:MM, varias separadas por comas) ---
# Cada franja se publica a su hora + un retraso aleatorio (JITTER). Una lista vacia desactiva ese tipo.
HORARIOS_FOTOS=11:30
HORARIOS_VIDEOS=18:00
# Ejemplo con varias al dia:  HORARIOS_FOTOS=09:00,13:30,20:00   HORARIOS_VIDEOS=12:00,19:00

# --- Limites diarios INDEPENDIENTES (0 desactiva ese tipo; si los quitas valen tantas como horas pongas) ---
# Si el limite es menor que el numero de franjas, solo se programan las primeras pendientes del dia.
MAX_FOTOS_DIA=1
MAX_VIDEOS_DIA=1

# --- Separacion minima entre publicaciones (de cualquier tipo, tambien las hechas a mano con --ahora) ---
# El autopiloto nunca publica a menos de estos minutos de la anterior: retrasa o aplaza la franja. 0 = sin separacion.
MIN_INTERVALO_MINUTOS=180

# --- Opcionales (estos son los valores por defecto) ---
GRAPH_VERSION=v27.0
JITTER_MIN=1
JITTER_MAX=15
# 1 = envia is_ai_generated=true al publicar un Reel. 0 (por defecto) = no se envia ese parametro en ninguna fase
IA_ETIQUETA=0
# 1 = genera todo pero NO publica (ensayo)
DRY_RUN=0
# Si el PC estuvo apagado/dormido mas de estas horas, esa franja del dia se omite
TOLERANCIA_HORAS=3
REINTENTOS=2
REINTENTO_MIN=20
# El estado diario (lo publicado y las franjas ya ejecutadas) se guarda en estado_autopiloto.json
# (en .gitignore). Para guardarlo en otro sitio:  ESTADO_ARCHIVO=ruta/mi_estado.json
