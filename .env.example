# Copia este archivo como ".env" (sin ".example") y rellena tus datos.
# NUNCA subas el .env a Git ni lo compartas: contiene el acceso a tu pagina (ya esta en .gitignore).

# --- Obligatorios ---
PAGE_ID=
PAGE_ACCESS_TOKEN=

# --- Opcionales (estos son los valores por defecto) ---
GRAPH_VERSION=v27.0
FOTO_HORA=11:30
VIDEO_HORA=18:00
JITTER_MIN=1
JITTER_MAX=15
MAX_POSTS_DIA=2
# 1 = marca los Reels como «contenido generado con IA» (la voz es sintetica)
IA_ETIQUETA=1
# 1 = genera todo pero NO publica (ensayo)
DRY_RUN=0
# Si el PC estuvo apagado/dormido mas de estas horas, esa tarea del dia se omite
TOLERANCIA_HORAS=3
REINTENTOS=2
REINTENTO_MIN=20
